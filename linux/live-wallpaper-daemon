#!/usr/bin/env gjs

imports.gi.versions.Gtk = '4.0';
imports.gi.versions.Gdk = '4.0';
imports.gi.versions.GdkX11 = '4.0';

const Gtk = imports.gi.Gtk;
const Gdk = imports.gi.Gdk;
const GdkX11 = imports.gi.GdkX11;
const Gio = imports.gi.Gio;
const GLib = imports.gi.GLib;
const Gst = imports.gi.Gst;
const Cairo = imports.gi.cairo;
const ByteArray = imports.byteArray;

if (!GLib.getenv('DISPLAY')) {
    GLib.setenv('DISPLAY', ':0', false);
}

Gtk.init();
Gst.init(null);

const homeDir = GLib.get_home_dir();
const defaultVideoPath = GLib.build_filenamev([
    homeDir,
    '.local',
    'share',
    'live-wallpaper',
    'current-live-wallpaper.mp4',
]);
const registryPath = GLib.build_filenamev([
    homeDir,
    '.config',
    'live-wallpaper',
    'registry.json',
]);
const runtimeOcclusionPath = GLib.build_filenamev([
    GLib.get_user_runtime_dir(),
    'live-wallpaper-occluded',
]);

function getPrimaryGeometry() {
    const disp = Gdk.Display.get_default();
    const monitors = disp ? disp.get_monitors() : null;
    if (monitors && monitors.get_n_items() > 0) {
        const mon = monitors.get_item(0);
        return mon.get_geometry();
    }
    return {x: 0, y: 0, width: 1368, height: 912};
}

let geom = getPrimaryGeometry();
const maxFps = Math.max(15, Math.min(120, parseInt(GLib.getenv('LIVE_WALLPAPER_MAX_FPS') || '30', 10) || 30));

// Hardware-accelerated zero-copy DMA-BUF sink (same engine & GdkCicpParams BT.709->sRGB color pipeline as GNOME Showtime)
const sink = Gst.ElementFactory.make('gtk4paintablesink', 'sink');
sink.set_property('sync', true);

// Wrap sink with zero-copy videorate (drop-only=true) to cap 60fps/120fps videos at 30fps without mapping DMABuf memory
let videoSinkElement = sink;
const rateLimiter = Gst.ElementFactory.make('videorate', 'ratelimiter');
if (rateLimiter) {
    rateLimiter.set_property('drop-only', true);
    rateLimiter.set_property('max-rate', maxFps);
    const sinkBin = Gst.Bin.new('video-sink-bin');
    sinkBin.add(rateLimiter);
    sinkBin.add(sink);
    if (rateLimiter.link(sink)) {
        const sinkPad = rateLimiter.get_static_pad('sink');
        if (sinkPad) {
            sinkBin.add_pad(Gst.GhostPad.new('sink', sinkPad));
            videoSinkElement = sinkBin;
        }
    }
}

const pipeline = Gst.ElementFactory.make('playbin', 'player');
pipeline.set_property('video-sink', videoSinkElement);
// GstPlayFlags: VIDEO (1 << 0) | NATIVE_VIDEO (1 << 6) = 65 (no audio/subtitles, direct VA-API DMA-BUF zero-copy)
pipeline.set_property('flags', (1 << 0) | (1 << 6));

const disp = Gdk.Display.get_default();
const cssProvider = new Gtk.CssProvider();
cssProvider.load_from_string(`
    window, window.background, picture {
        background-color: transparent;
        background-image: none;
        box-shadow: none;
        border: none;
    }
`);
if (disp) {
    Gtk.StyleContext.add_provider_for_display(
        disp,
        cssProvider,
        Gtk.STYLE_PROVIDER_PRIORITY_USER + 100
    );
}

const emptyBytes = GLib.Bytes.new(new Uint8Array([0, 0, 0, 0]));
const emptyPaintable = Gdk.MemoryTexture.new(1, 1, Gdk.MemoryFormat.B8G8R8A8, emptyBytes, 4);

const paintable = sink.get_property('paintable');
const picture = new Gtk.Picture({
    paintable: emptyPaintable,
    content_fit: Gtk.ContentFit.COVER,
    hexpand: true,
    vexpand: true,
    can_target: false,
    focusable: false,
});

const win = new Gtk.Window({
    title: 'GNOME Live Wallpaper',
    decorated: false,
    can_target: false,
    focusable: false,
    focus_on_click: false,
});
win.set_default_size(geom.width, geom.height);
win.set_size_request(geom.width, geom.height);
win.set_child(picture);

let winXid = 0;
let hintsAppliedForXid = 0;
let lastTransparentState = null;
let isLiveActive = false;
let fadeTimerId = 0;
let errorRetryTimerId = 0;
let pendingPreroll = false;
let segmentArmed = false;

function cancelFadeAnimation() {
    if (fadeTimerId !== 0) {
        GLib.source_remove(fadeTimerId);
        fadeTimerId = 0;
    }
}

function cancelErrorRetryTimer() {
    if (errorRetryTimerId !== 0) {
        GLib.source_remove(errorRetryTimerId);
        errorRetryTimerId = 0;
    }
}

function setWindowTransparent(transparent) {
    const surf = win.get_surface();
    if (surf && typeof surf.get_xid === 'function') {
        winXid = surf.get_xid();
    }
    if (!winXid) {
        return;
    }
    if (lastTransparentState === transparent) {
        return;
    }
    lastTransparentState = transparent;
    if (transparent) {
        GLib.spawn_command_line_sync(
            `xprop -id ${winXid} -f _NET_WM_WINDOW_OPACITY 32c -set _NET_WM_WINDOW_OPACITY 0`
        );
    } else {
        GLib.spawn_command_line_sync(
            `xprop -id ${winXid} -remove _NET_WM_WINDOW_OPACITY`
        );
    }
}

function startFadeIn() {
    cancelFadeAnimation();
    setWindowTransparent(false);
    if (picture.get_paintable() !== paintable) {
        picture.set_paintable(paintable);
    }
    const surf = win.get_surface();
    if (surf) {
        surf.set_input_region(new Cairo.Region());
    }

    const totalSteps = 9;
    let step = 1;
    picture.set_opacity(0.12);
    picture.queue_draw();

    fadeTimerId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 20, () => {
        if (!isLiveActive) {
            fadeTimerId = 0;
            return GLib.SOURCE_REMOVE;
        }
        step += 1;
        if (step >= totalSteps) {
            picture.set_opacity(1.0);
            picture.queue_draw();
            fadeTimerId = 0;
            return GLib.SOURCE_REMOVE;
        }
        // Cubic ease-out curve for silky visual appearance
        const t = step / totalSteps;
        const eased = 1.0 - Math.pow(1.0 - t, 3);
        picture.set_opacity(Math.max(0.12, Math.min(1.0, eased)));
        picture.queue_draw();
        return GLib.SOURCE_CONTINUE;
    });
}

function startFadeOutToStatic() {
    cancelFadeAnimation();

    // If already showing emptyPaintable, immediately finalize static state
    if (picture.get_paintable() === emptyPaintable) {
        picture.set_opacity(1.0);
        picture.queue_draw();
        win.queue_draw();
        setWindowTransparent(true);
        pipeline.set_state(Gst.State.NULL);
        return;
    }

    // Pause on the current video frame so it can smoothly dissolve over the static wallpaper
    pipeline.set_state(Gst.State.PAUSED);

    const totalSteps = 8;
    let step = 0;

    fadeTimerId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 20, () => {
        if (isLiveActive) {
            fadeTimerId = 0;
            return GLib.SOURCE_REMOVE;
        }
        step += 1;
        if (step >= totalSteps) {
            picture.set_paintable(emptyPaintable);
            picture.set_opacity(1.0);
            picture.queue_draw();
            win.queue_draw();
            setWindowTransparent(true);
            pipeline.set_state(Gst.State.NULL);
            fadeTimerId = 0;
            return GLib.SOURCE_REMOVE;
        }
        const t = step / totalSteps;
        const alpha = Math.max(0.06, 1.0 - t * 0.92);
        picture.set_opacity(alpha);
        picture.queue_draw();
        return GLib.SOURCE_CONTINUE;
    });
}

function applyDesktopWindowHints() {
    const surf = win.get_surface();
    if (!surf) {
        return;
    }
    if (typeof surf.get_xid === 'function') {
        winXid = surf.get_xid();
        if (winXid && hintsAppliedForXid !== winXid) {
            hintsAppliedForXid = winXid;
            lastTransparentState = null;
            GLib.spawn_command_line_sync(
                `xprop -id ${winXid} -f _NET_WM_WINDOW_TYPE 32a -set _NET_WM_WINDOW_TYPE _NET_WM_WINDOW_TYPE_DESKTOP`
            );
            GLib.spawn_command_line_sync(
                `xprop -id ${winXid} -f _NET_WM_STATE 32a -set _NET_WM_STATE _NET_WM_STATE_BELOW,_NET_WM_STATE_STICKY,_NET_WM_STATE_SKIP_TASKBAR,_NET_WM_STATE_SKIP_PAGER`
            );
        }
        setWindowTransparent(!isLiveActive);
    }
    surf.set_input_region(new Cairo.Region());
}

win.connect('realize', () => {
    applyDesktopWindowHints();
});

win.connect('map', () => {
    GLib.idle_add(GLib.PRIORITY_DEFAULT, () => {
        applyDesktopWindowHints();
        return GLib.SOURCE_REMOVE;
    });
});

win.set_visible(true);

let trackedMonitor = null;
let monitorGeomSigId = 0;
let monitorScaleSigId = 0;

// Set just before the first syncWallpaperMode(): the settings objects it uses are created below.
let daemonReady = false;

function updateMonitorGeometry() {
    geom = getPrimaryGeometry();
    win.set_default_size(geom.width, geom.height);
    win.set_size_request(geom.width, geom.height);
    // A fitted copy may no longer cover the monitor (rotated to portrait), or may again.
    if (daemonReady) {
        syncWallpaperMode();
    }
}

function bindMonitorSignals() {
    const monitors = disp ? disp.get_monitors() : null;
    if (!monitors || monitors.get_n_items() === 0) {
        return;
    }
    const primaryMon = monitors.get_item(0);
    if (trackedMonitor === primaryMon) {
        return;
    }
    if (trackedMonitor) {
        if (monitorGeomSigId) trackedMonitor.disconnect(monitorGeomSigId);
        if (monitorScaleSigId) trackedMonitor.disconnect(monitorScaleSigId);
    }
    trackedMonitor = primaryMon;
    if (trackedMonitor) {
        monitorGeomSigId = trackedMonitor.connect('notify::geometry', () => updateMonitorGeometry());
        monitorScaleSigId = trackedMonitor.connect('notify::scale-factor', () => updateMonitorGeometry());
    }
    updateMonitorGeometry();
}

const monitors = disp ? disp.get_monitors() : null;
if (monitors) {
    bindMonitorSignals();
    monitors.connect('items-changed', () => bindMonitorSignals());
}

let currentVideoPath = '';
let currentSourcePath = '';
let isScreenLocked = false;
let isDisplayOff = false;
let isOccluded = false;
let isPowerSaver = false;
let isSystemSleeping = false;
let errorRetries = 0;

if (GLib.file_test(runtimeOcclusionPath, GLib.FileTest.EXISTS)) {
    try {
        const [ok, bytes] = GLib.file_get_contents(runtimeOcclusionPath);
        if (ok) {
            isOccluded = ByteArray.toString(bytes).trim() === '1';
        }
    } catch (_e) {
        // Ignore read error
    }
}

function shouldPausePlayback() {
    return isScreenLocked || isDisplayOff || isOccluded || isPowerSaver || isSystemSleeping;
}

function updatePlaybackState(reason) {
    if (!isLiveActive) {
        return;
    }
    const paused = shouldPausePlayback();
    if (reason) {
        print(`[LiveWallpaper] ${paused ? 'Pausing' : 'Resuming'} playback (${reason})`);
    }
    pipeline.set_state(paused ? Gst.State.PAUSED : Gst.State.PLAYING);
}

const bus = pipeline.get_bus();
bus.add_signal_watch();

bus.connect('message::async-done', () => {
    if (!isLiveActive) {
        return;
    }
    errorRetries = 0;

    if (pendingPreroll) {
        pendingPreroll = false;
        startFadeIn();
    }

    if (!segmentArmed) {
        segmentArmed = true;
        // Arm segment loop for seamless looping at end of stream
        pipeline.seek(
            1.0,
            Gst.Format.TIME,
            Gst.SeekFlags.FLUSH | Gst.SeekFlags.SEGMENT,
            Gst.SeekType.SET,
            0,
            Gst.SeekType.NONE,
            -1
        );
        return;
    }

    if (shouldPausePlayback()) {
        pipeline.set_state(Gst.State.PAUSED);
    }
});

bus.connect('message::segment-done', () => {
    if (isLiveActive) {
        const ok = pipeline.seek(
            1.0,
            Gst.Format.TIME,
            Gst.SeekFlags.SEGMENT,
            Gst.SeekType.SET,
            0,
            Gst.SeekType.NONE,
            -1
        );
        if (!ok) {
            pipeline.seek_simple(
                Gst.Format.TIME,
                Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                0
            );
        }
    }
});

bus.connect('message::eos', () => {
    if (isLiveActive) {
        pipeline.seek(
            1.0,
            Gst.Format.TIME,
            Gst.SeekFlags.FLUSH | Gst.SeekFlags.SEGMENT,
            Gst.SeekType.SET,
            0,
            Gst.SeekType.NONE,
            -1
        );
    }
});

bus.connect('message::error', (_bus, msg) => {
    const [err, dbg] = msg.parse_error();
    printerr(`[LiveWallpaper] GStreamer error: ${err.message} (${dbg || 'no debug'})\n`);
    pipeline.set_state(Gst.State.NULL);
    cancelErrorRetryTimer();
    if (currentSourcePath && currentVideoPath !== currentSourcePath) {
        // The fitted copy is broken: fall back to the original file for the rest of this session.
        printerr(`[LiveWallpaper] Fitted copy failed, playing the original instead: ${currentSourcePath}\n`);
        brokenFitted.add(currentVideoPath);
        currentVideoPath = currentSourcePath;
        errorRetries = 0;
    }
    errorRetries += 1;
    if (errorRetries <= 3 && isLiveActive && !shouldPausePlayback() && currentVideoPath) {
        errorRetryTimerId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 500, () => {
            errorRetryTimerId = 0;
            if (isLiveActive && !shouldPausePlayback() && currentVideoPath) {
                pendingPreroll = true;
                segmentArmed = false;
                pipeline.set_property('uri', GLib.filename_to_uri(currentVideoPath, null));
                pipeline.set_state(Gst.State.PLAYING);
            }
            return GLib.SOURCE_REMOVE;
        });
    } else if (errorRetries > 3) {
        printerr('[LiveWallpaper] Exceeded max error retries, halting playback until next wallpaper change.\n');
    }
});

const bgSettings = new Gio.Settings({schema_id: 'org.gnome.desktop.background'});
const ifaceSettings = new Gio.Settings({schema_id: 'org.gnome.desktop.interface'});

function uriToPath(uri) {
    if (!uri || uri === 'none') {
        return null;
    }
    if (uri.startsWith('file://')) {
        try {
            const [path] = GLib.filename_from_uri(uri);
            return path;
        } catch (_e) {
            return decodeURIComponent(uri.replace(/^file:\/\//, ''));
        }
    }
    return uri;
}

function getActiveWallpaperPath() {
    const scheme = ifaceSettings.get_string('color-scheme');
    let uri = '';
    if (scheme === 'prefer-dark') {
        uri = bgSettings.get_string('picture-uri-dark');
        if (!uri || uri === 'none') {
            uri = bgSettings.get_string('picture-uri');
        }
    } else {
        uri = bgSettings.get_string('picture-uri');
        if (!uri || uri == 'none') {
            uri = bgSettings.get_string('picture-uri-dark');
        }
    }
    return uriToPath(uri);
}

function readRegistry() {
    if (!GLib.file_test(registryPath, GLib.FileTest.EXISTS)) {
        return {};
    }
    try {
        const [ok, bytes] = GLib.file_get_contents(registryPath);
        return ok ? JSON.parse(ByteArray.toString(bytes)) : {};
    } catch (e) {
        printerr(`[LiveWallpaper] Failed to parse registry.json: ${e}\n`);
        return {};
    }
}

function realPath(path) {
    for (let i = 0; i < 8 && GLib.file_test(path, GLib.FileTest.IS_SYMLINK); i++) {
        const target = GLib.file_read_link(path);
        path = GLib.path_is_absolute(target)
            ? target
            : GLib.build_filenamev([GLib.path_get_dirname(path), target]);
    }
    return path;
}

// Physical pixels of the monitor the wallpaper window covers.
function monitorPixelSize() {
    const mons = disp ? disp.get_monitors() : null;
    const mon = mons && mons.get_n_items() > 0 ? mons.get_item(0) : null;
    if (!mon) {
        return [0, 0];
    }
    const g = mon.get_geometry();
    const scale = typeof mon.get_scale === 'function' ? mon.get_scale() : mon.get_scale_factor();
    return [Math.round(g.width * scale), Math.round(g.height * scale)];
}

// Fitted copies (lumina-fit-video) that failed to play; the original is used instead.
const brokenFitted = new Set();

// lumina-fit-video writes a copy of each wallpaper sized to the screen and capped at 30 fps,
// so the decoder does not decode pixels and frames that are never shown. Play it only while it
// still covers this monitor (not after rotating to portrait), the frame cap it was made for is
// not below ours, and the original has not changed since.
function playbackFileFor(sourcePath) {
    const source = realPath(sourcePath);
    const fit = (readRegistry().fitted || {})[source];
    if (!fit || !fit.path || brokenFitted.has(fit.path) || !GLib.file_test(fit.path, GLib.FileTest.EXISTS)) {
        return sourcePath;
    }
    try {
        const info = Gio.File.new_for_path(source).query_info('standard::size,time::modified', Gio.FileQueryInfoFlags.NONE, null);
        if (info.get_size() !== fit.sourceSize || info.get_attribute_uint64('time::modified') !== fit.sourceMtime) {
            return sourcePath;
        }
    } catch (_e) {
        return sourcePath;
    }
    const [w, h] = monitorPixelSize();
    if (!w || fit.width + 2 < w || fit.height + 2 < h || (fit.maxFps || 0) < maxFps) {
        return sourcePath;
    }
    return fit.path;
}

function resolveLiveVideoForWallpaper(wallpaperPath) {
    if (!wallpaperPath) {
        return null;
    }
    const baseName = GLib.path_get_basename(wallpaperPath);

    const map = readRegistry().wallpapers || {};
    const registered = map[wallpaperPath] || map[baseName];
    if (registered && GLib.file_test(registered, GLib.FileTest.EXISTS)) {
        return registered;
    }

    if (/-(live-)?cover\.(png|jpe?g)$/i.test(baseName)) {
        const stem = baseName.replace(/-(live-)?cover\.(png|jpe?g)$/i, '');
        const candidate = GLib.build_filenamev([
            homeDir,
            '.local',
            'share',
            'live-wallpaper',
            `${stem}-live.mp4`,
        ]);
        if (GLib.file_test(candidate, GLib.FileTest.EXISTS)) {
            return candidate;
        }
        if (GLib.file_test(defaultVideoPath, GLib.FileTest.EXISTS)) {
            return defaultVideoPath;
        }
    }

    return null;
}

function syncWallpaperMode() {
    const activeWallpaper = getActiveWallpaperPath();
    const sourceVideo = resolveLiveVideoForWallpaper(activeWallpaper);
    const targetVideo = sourceVideo ? playbackFileFor(sourceVideo) : null;

    if (targetVideo) {
        errorRetries = 0;
        cancelErrorRetryTimer();
        const wasLiveActive = isLiveActive;
        const videoChanged = currentVideoPath !== targetVideo || !isLiveActive;
        isLiveActive = true;

        if (videoChanged) {
            cancelFadeAnimation();
            currentVideoPath = targetVideo;
            currentSourcePath = sourceVideo;
            pendingPreroll = true;
            segmentArmed = false;
            print(`[LiveWallpaper] Activating dynamic video wallpaper: ${currentVideoPath} (cover: ${activeWallpaper})`);

            if (!wasLiveActive) {
                // Coming from static wallpaper: keep emptyPaintable until first video frame prerolls
                picture.set_paintable(emptyPaintable);
                picture.set_opacity(1.0);
                picture.queue_draw();
            } else {
                // Switching from dynamic video A -> dynamic video B: dim smoothly without flashing empty static frame
                picture.set_opacity(0.24);
                picture.queue_draw();
            }

            pipeline.set_state(Gst.State.NULL);
            pipeline.set_property('uri', GLib.filename_to_uri(currentVideoPath, null));
            // Start PLAYING briefly to preroll & arm segment seek; async-done will pause if occluded/locked
            pipeline.set_state(Gst.State.PLAYING);
        } else {
            updatePlaybackState();
        }
    } else {
        cancelErrorRetryTimer();
        if (isLiveActive) {
            print(`[LiveWallpaper] Switching to native static wallpaper: ${activeWallpaper}`);
            isLiveActive = false;
            pendingPreroll = false;
            startFadeOutToStatic();
        } else {
            isLiveActive = false;
            pendingPreroll = false;
            picture.set_paintable(emptyPaintable);
            picture.set_opacity(1.0);
            picture.queue_draw();
            win.queue_draw();
            setWindowTransparent(true);
            pipeline.set_state(Gst.State.NULL);
        }
    }
}

bgSettings.connect('changed::picture-uri', () => syncWallpaperMode());
bgSettings.connect('changed::picture-uri-dark', () => syncWallpaperMode());
ifaceSettings.connect('changed::color-scheme', () => syncWallpaperMode());

// 1. Screen Lock Auto-Pause (org.gnome.ScreenSaver)
try {
    Gio.DBus.session.signal_subscribe(
        'org.gnome.ScreenSaver',
        'org.gnome.ScreenSaver',
        'ActiveChanged',
        '/org/gnome/ScreenSaver',
        null,
        Gio.DBusSignalFlags.NONE,
        (_conn, _sender, _path, _iface, _signal, params) => {
            const [locked] = params.deep_unpack();
            if (isScreenLocked !== locked) {
                isScreenLocked = locked;
                updatePlaybackState(locked ? 'screen locked' : 'screen unlocked');
            }
        }
    );
} catch (_e) {
    // Ignore if ScreenSaver D-Bus is unavailable
}

// 2. Display Blank / DPMS Sleep Auto-Pause (org.gnome.Mutter.DisplayConfig)
try {
    Gio.DBus.session.signal_subscribe(
        'org.gnome.Mutter.DisplayConfig',
        'org.freedesktop.DBus.Properties',
        'PropertiesChanged',
        '/org/gnome/Mutter/DisplayConfig',
        null,
        Gio.DBusSignalFlags.NONE,
        (_conn, _sender, _path, _iface, _signal, params) => {
            const [ifaceName, changed] = params.deep_unpack();
            if (ifaceName === 'org.gnome.Mutter.DisplayConfig' && changed.PowerSaveMode !== undefined) {
                const mode = changed.PowerSaveMode.deep_unpack();
                const off = mode !== 0;
                if (isDisplayOff !== off) {
                    isDisplayOff = off;
                    updatePlaybackState(off ? 'display sleep' : 'display wake');
                }
            }
        }
    );
} catch (_e) {
    // Ignore if DisplayConfig D-Bus is unavailable
}

// 3. Window Occlusion Auto-Pause (Maximized / Fullscreen from GNOME Shell Extension)
try {
    Gio.DBus.session.signal_subscribe(
        null,
        'org.gnome.LiveWallpaper',
        'OcclusionChanged',
        '/org/gnome/LiveWallpaper',
        null,
        Gio.DBusSignalFlags.NONE,
        (_conn, _sender, _path, _iface, _signal, params) => {
            const [occluded] = params.deep_unpack();
            if (isOccluded !== occluded) {
                isOccluded = occluded;
                updatePlaybackState(occluded ? 'desktop occluded' : 'desktop visible');
            }
        }
    );
} catch (_e) {
    // Ignore if session D-Bus signal fails
}

// 4. System Power Saver Profile Auto-Pause (net.hadess.PowerProfiles)
try {
    const reply = Gio.DBus.system.call_sync(
        'net.hadess.PowerProfiles',
        '/net/hadess/PowerProfiles',
        'org.freedesktop.DBus.Properties',
        'Get',
        new GLib.Variant('(ss)', ['net.hadess.PowerProfiles', 'ActiveProfile']),
        null,
        Gio.DBusCallFlags.NONE,
        1000,
        null
    );
    if (reply) {
        const [val] = reply.deep_unpack();
        isPowerSaver = val.deep_unpack() === 'power-saver';
    }

    Gio.DBus.system.signal_subscribe(
        'net.hadess.PowerProfiles',
        'org.freedesktop.DBus.Properties',
        'PropertiesChanged',
        '/net/hadess/PowerProfiles',
        null,
        Gio.DBusSignalFlags.NONE,
        (_conn, _sender, _path, _iface, _signal, params) => {
            const [ifaceName, changed] = params.deep_unpack();
            if (ifaceName === 'net.hadess.PowerProfiles' && changed.ActiveProfile !== undefined) {
                const profile = changed.ActiveProfile.deep_unpack();
                const saver = profile === 'power-saver';
                if (isPowerSaver !== saver) {
                    isPowerSaver = saver;
                    updatePlaybackState(saver ? 'power-saver enabled' : `power profile: ${profile}`);
                }
            }
        }
    );
} catch (_e) {
    // Ignore if PowerProfiles daemon is unavailable
}

// 5. System Suspend / Resume Recovery (org.freedesktop.login1.Manager PrepareForSleep)
try {
    Gio.DBus.system.signal_subscribe(
        'org.freedesktop.login1',
        'org.freedesktop.login1.Manager',
        'PrepareForSleep',
        '/org/freedesktop/login1',
        null,
        Gio.DBusSignalFlags.NONE,
        (_conn, _sender, _path, _iface, _signal, params) => {
            const [sleeping] = params.deep_unpack();
            if (isSystemSleeping !== sleeping) {
                isSystemSleeping = sleeping;
                if (sleeping) {
                    if (isLiveActive) {
                        print('[LiveWallpaper] System suspending, releasing hardware decoder state');
                        pipeline.set_state(Gst.State.PAUSED);
                    }
                } else {
                    if (isLiveActive && currentVideoPath) {
                        print('[LiveWallpaper] System resumed from suspend, refreshing VA-API/DMABuf pipeline');
                        pendingPreroll = true;
                        segmentArmed = false;
                        pipeline.set_state(Gst.State.NULL);
                        pipeline.set_property('uri', GLib.filename_to_uri(currentVideoPath, null));
                        pipeline.set_state(Gst.State.PLAYING);
                    }
                }
            }
        }
    );
} catch (_e) {
    // Ignore if login1 D-Bus is unavailable
}

daemonReady = true;
syncWallpaperMode();

const mainLoop = GLib.MainLoop.new(null, false);
mainLoop.run();
